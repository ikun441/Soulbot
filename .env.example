# 可选：留空可通过 WebUI 输入。请勿提交实际 .env。
# 管理员账号：同时填写用户名和密码，启动时应用（包括重置已有账号）。
# 明文密码会在首次成功读取时转换为 PASSWORD_HASH，PASSWORD 行随后删除。
# 使用 WebUI 创建/修改账号也会自动写入用户名与哈希；无需手工计算哈希。
SOULBOT_WEBUI_USERNAME=
SOULBOT_WEBUI_PASSWORD=
SOULBOT_WEBUI_PASSWORD_HASH=

# NapCat WebSocket 客户端应填写的 SoulBot 反向接收地址。
# 支持反代 wss://域名/路径；留空按 web.host/web.port 自动生成。
# 修改后重启，不会自动开启 QQ 或修改监听端口；Token 在下面单独配置。
SOULBOT_ONEBOT_REVERSE_WS_URL=

SOULBOT_LLM_API_KEY=
SOULBOT_ONEBOT_ACCESS_TOKEN=
# 可选：兼容语音服务的独立密钥，不自动复用 LLM Key。
SOULBOT_TTS_API_KEY=
# ASR 独立密钥；本地识别无需填写，不复用聊天/语音合成密钥。
SOULBOT_ASR_API_KEY=
# 云端生图独立密钥，不自动复用聊天、TTS 或 ASR 凭据。
SOULBOT_IMAGE_API_KEY=
